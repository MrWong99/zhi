version: "1"

config:
  provider: {{.ConfigProvider}}
  options:
    directory: ./config

components:
  - name: pokedex-web
    description: "Pokedex web UI - your digital gateway to the Pokemon world"
    paths:
      - "pokedex-web/"
    mandatory: true
  - name: pokemon-api
    description: "Pokemon data API - the source of all Pokemon knowledge"
    paths:
      - "pokemon-api/"
    mandatory: true
  - name: trainer-info
    description: "Trainer details for a personalized Pokedex"
    paths:
      - "trainer-info/"
    mandatory: false

export:
  templates:
    - name: docker-compose
      template: ./templates/docker-compose.yml.tmpl
      output: ./docker-compose.yml

apply:
  command: "docker compose up -d"
  workdir: "."
  pre-export: true
  env:
    COMPOSE_PROJECT_NAME: "pokedex_api"
  timeout: 300
