{{- fileMode 0644 -}}
# Vault server configuration
# Generated by zhi -- do not edit manually

ui = {{ .Get "vault-server/ui" }}

listener "tcp" {
  address     = "0.0.0.0:8200"
{{- if eq (.Get "vault-server/tls/enabled" | toString) "true" }}
  tls_cert_file      = "/vault/tls/cert.pem"
  tls_key_file       = "/vault/tls/key.pem"
  {{- with .Get "vault-server/tls/client-ca-file" }}
  tls_client_ca_file = "/vault/tls/client-ca.pem"
  {{- end }}
  tls_disable = false
{{- else }}
  tls_disable = true
{{- end }}
}

storage "{{ .Get "vault-server/storage-backend" }}" {
  path = "{{ .Get "vault-server/storage-path" }}"
}

api_addr     = "{{ .Get "vault-server/api-addr" }}"
cluster_addr = "{{ .Get "vault-server/cluster-addr" }}"
log_level    = "{{ .Get "vault-server/log-level" }}"
