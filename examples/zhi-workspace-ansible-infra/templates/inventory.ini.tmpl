# Ansible INI inventory generated by zhi
# Do not edit manually -- changes will be overwritten on next export.

{{- range $group, $vals := .Nested "groups" }}
{{- $members := index $vals "members" }}
{{- if $members }}

[{{ $group }}]
{{- range $m := splitList "," (toString $members) }}
{{- $host := trim $m }}
{{- $hostData := index ($.Nested "hosts") $host }}
{{- if $hostData }}
{{ $host }} ansible_host={{ index $hostData "ansible_host" }}{{ if index $hostData "ansible_user" }} ansible_user={{ index $hostData "ansible_user" }}{{ end }}{{ if index $hostData "ansible_port" }} ansible_port={{ index $hostData "ansible_port" }}{{ end }}
{{- end }}
{{- end }}

[{{ $group }}:vars]
{{- $gvars := index $vals "vars" }}
{{- if $gvars }}
{{- range $k, $v := $gvars }}
{{ $k }}={{ $v }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
