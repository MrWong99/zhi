schemaVersion: "1"
name: [[.PluginName]]
type: [[.PluginType]]
version: [[.Version]]
zhiProtocolVersion: "1"
description: [[printf "%q" .Description]]
[[- if .Author]]
author: [[printf "%q" .Author]]
[[- end]]
[[- if .License]]
license: [[printf "%q" .License]]
[[- end]]
keywords:
  - [[.PluginType]]
  - [[.PluginName]]

binaries:
  linux/amd64: dist/[[.BinaryName]]_linux_amd64
  linux/arm64: dist/[[.BinaryName]]_linux_arm64
  darwin/amd64: dist/[[.BinaryName]]_darwin_amd64
  darwin/arm64: dist/[[.BinaryName]]_darwin_arm64
