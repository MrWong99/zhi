apiVersion: v1
kind: Service
metadata:
  name: vault
  namespace: {{ .Get "vault-deploy/k8s/namespace" }}
  labels:
    app.kubernetes.io/name: vault
    app.kubernetes.io/managed-by: zhi
spec:
  type: {{ .Get "vault-deploy/k8s/service-type" }}
  selector:
    app.kubernetes.io/name: vault
  ports:
    - name: api
      port: 8200
      targetPort: 8200
      protocol: TCP
    - name: cluster
      port: 8201
      targetPort: 8201
      protocol: TCP
