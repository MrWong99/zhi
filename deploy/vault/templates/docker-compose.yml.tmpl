# Vault Docker Compose deployment
# Generated by zhi -- do not edit manually

services:
  vault-init:
    image: hashicorp/vault:{{ .Get "vault-deploy/vault-version" }}
    container_name: vault-init
    user: root
    command: ["sh", "-c", "chown -R vault:vault {{ .Get "vault-server/storage-path" }}"]
    volumes:
      - {{ .Get "vault-deploy/docker/volume-name" }}:{{ .Get "vault-server/storage-path" }}

  vault:
    image: hashicorp/vault:{{ .Get "vault-deploy/vault-version" }}
    container_name: vault
    restart: unless-stopped
    depends_on:
      vault-init:
        condition: service_completed_successfully
    ports:
      - "{{ .Get "vault-deploy/docker/port" }}:8200"
    volumes:
      - {{ .Get "vault-deploy/docker/volume-name" }}:{{ .Get "vault-server/storage-path" }}
      - ./vault-config.hcl:/vault/config/vault.hcl:ro
{{- if eq (.Get "vault-server/tls/enabled" | toString) "true" }}
      - {{ .Get "vault-server/tls/cert-file" }}:/vault/tls/cert.pem:ro
      - {{ .Get "vault-server/tls/key-file" }}:/vault/tls/key.pem:ro
  {{- with .Get "vault-server/tls/client-ca-file" }}
      - {{ . }}:/vault/tls/ca.pem:ro
  {{- end }}
{{- end }}
    environment:
      VAULT_ADDR: "http://127.0.0.1:8200"
      VAULT_API_ADDR: "{{ .Get "vault-server/api-addr" }}"
    cap_add:
      - IPC_LOCK
    command: ["server"]
    healthcheck:
      test: ["CMD-SHELL", "vault status -address http://127.0.0.1:8200 || [ $$? -ne 1 ]"]
      interval: 5s
      timeout: 3s
      retries: 12
      start_period: 5s

volumes:
  {{ .Get "vault-deploy/docker/volume-name" }}:
