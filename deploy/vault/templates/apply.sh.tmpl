{{- fileMode 0700 -}}
#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# Vault Deployment & Bootstrap Script
# Generated by zhi -- do not edit manually
# =============================================================================

VAULT_ADDR="{{ .Get "vault-server/api-addr" }}"
DEPLOY_MODE="{{ .Get "vault-deploy/mode" }}"
UNSEAL_SHARES={{ .Get "vault-deploy/unseal-shares" }}
UNSEAL_THRESHOLD={{ .Get "vault-deploy/unseal-threshold" }}
ADMIN_USER="{{ .Get "vault-auth/admin-username" }}"
ADMIN_PASS="{{ .Get "vault-auth/admin-password" }}"
AUTH_METHODS="{{ .Get "vault-auth/methods" }}"
{{- if .ComponentEnabled "vault-secrets" }}
SECRET_ENGINES="{{ .Get "vault-secrets/engines" }}"
{{- end }}
TLS_ENABLED={{ .Get "vault-server/tls/enabled" }}
{{- if eq (.Get "vault-server/tls/enabled" | toString) "true" }}
{{- if .Get "vault-server/tls/server-ca-file" }}
TLS_SERVER_CA_FILE="{{ .Get "vault-server/tls/server-ca-file" }}"
{{- end }}
{{- if .Get "vault-server/tls/client-ca-file" }}
TLS_CLIENT_CERT="{{ .Get "vault-server/tls/cert-file" }}"
TLS_CLIENT_KEY="{{ .Get "vault-server/tls/key-file" }}"
{{- end }}
{{- end }}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLEANUP_FILES=()

# --- Helpers -----------------------------------------------------------------

log()  { printf '[INFO]  %s\n' "$*"; }
warn() { printf '[WARN]  %s\n' "$*"; }
err()  { printf '[ERROR] %s\n' "$*" >&2; }
die()  { err "$@"; cleanup; exit 1; }

cleanup() {
    for f in "${CLEANUP_FILES[@]}"; do
        if [ -f "$f" ]; then
            log "Deleting sensitive file: $f"
            rm -f "$f"
        fi
    done
}
trap cleanup EXIT

vault_curl() {
    local method="$1"; shift
    local path="$1"; shift
    local curl_opts=(-s -S --fail-with-body -X "$method")
    if [ "$TLS_ENABLED" = "true" ] && [ -n "${TLS_SERVER_CA_FILE:-}" ]; then
        curl_opts+=(--cacert "$TLS_SERVER_CA_FILE")
    fi
    if [ -n "${TLS_CLIENT_CERT:-}" ] && [ -n "${TLS_CLIENT_KEY:-}" ]; then
        curl_opts+=(--cert "$TLS_CLIENT_CERT" --key "$TLS_CLIENT_KEY")
    fi
    if [ -n "${VAULT_TOKEN:-}" ]; then
        curl_opts+=(-H "X-Vault-Token: $VAULT_TOKEN")
    fi
    curl "${curl_opts[@]}" "${VAULT_ADDR}/v1/${path}" "$@"
}

# --- Prerequisite Checks ----------------------------------------------------

log "Checking prerequisites..."
for cmd in curl jq; do
    command -v "$cmd" >/dev/null 2>&1 || die "$cmd is required but not found in PATH"
done

case "$DEPLOY_MODE" in
    host)
        command -v vault >/dev/null 2>&1 || die "vault binary is required for host deployment"
        ;;
    docker)
        command -v docker >/dev/null 2>&1 || die "docker is required for Docker deployment"
        docker compose version >/dev/null 2>&1 || die "docker compose plugin is required"
        ;;
    kubernetes)
        command -v kubectl >/dev/null 2>&1 || die "kubectl is required for Kubernetes deployment"
        ;;
esac

# --- Step 1: Start Vault ----------------------------------------------------

log "Starting Vault in $DEPLOY_MODE mode..."

case "$DEPLOY_MODE" in
    host)
        vault server -config="${SCRIPT_DIR}/vault-config.hcl" &
        VAULT_PID=$!
        log "Vault server started (PID: $VAULT_PID)"
        ;;
    docker)
        cd "$SCRIPT_DIR"
        docker compose up -d --wait
        log "Vault container started via Docker Compose"
        ;;
    kubernetes)
        kubectl apply -f "${SCRIPT_DIR}/k8s-namespace.yml"
        kubectl apply -f "${SCRIPT_DIR}/k8s-configmap.yml"
        kubectl apply -f "${SCRIPT_DIR}/k8s-statefulset.yml"
        kubectl apply -f "${SCRIPT_DIR}/k8s-service.yml"
        {{- if eq (.Get "vault-deploy/k8s/ingress-enabled" | toString) "true" }}
        kubectl apply -f "${SCRIPT_DIR}/k8s-ingress.yml"
        {{- end }}
        log "Kubernetes resources applied"
        NS="{{ .Get "vault-deploy/k8s/namespace" }}"
        log "Waiting for Vault pod to be ready..."
        kubectl -n "$NS" rollout status statefulset/vault --timeout=120s
        # Port-forward for bootstrap (background)
        kubectl -n "$NS" port-forward svc/vault 8200:8200 &
        PF_PID=$!
        VAULT_ADDR="http://127.0.0.1:8200"
        sleep 2
        ;;
esac

# --- Step 2: Wait for Vault -------------------------------------------------

log "Waiting for Vault to become available..."
for i in $(seq 1 30); do
    # /sys/health returns 200 if initialized+unsealed, 429 if standby,
    # 472 if DR secondary, 473 if perf standby, 501 if not initialized,
    # 503 if sealed. We accept any of these as "available".
    HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" "${VAULT_ADDR}/v1/sys/health" \
        {{- if eq (.Get "vault-server/tls/enabled" | toString) "true" }}
        ${TLS_SERVER_CA_FILE:+--cacert "$TLS_SERVER_CA_FILE"} \
        ${TLS_CLIENT_CERT:+--cert "$TLS_CLIENT_CERT"} ${TLS_CLIENT_KEY:+--key "$TLS_CLIENT_KEY"} \
        {{- end }}
        --connect-timeout 2 2>/dev/null || echo "000")
    if [ "$HTTP_CODE" != "000" ]; then
        break
    fi
    if [ "$i" -eq 30 ]; then
        die "Vault did not become available within 60 seconds"
    fi
    sleep 2
done
log "Vault is available at $VAULT_ADDR (status: $HTTP_CODE)"

# --- Step 3: Initialize Vault -----------------------------------------------

log "Initializing Vault (shares=$UNSEAL_SHARES, threshold=$UNSEAL_THRESHOLD)..."
INIT_RESPONSE=$(vault_curl POST "sys/init" \
    -H "Content-Type: application/json" \
    -d "{\"secret_shares\": $UNSEAL_SHARES, \"secret_threshold\": $UNSEAL_THRESHOLD}") || {
    err "Failed to initialize Vault. Response: $INIT_RESPONSE"
    die "Vault initialization failed"
}

UNSEAL_KEYS=$(echo "$INIT_RESPONSE" | jq -r '.keys[]')
ROOT_TOKEN=$(echo "$INIT_RESPONSE" | jq -r '.root_token')

echo ""
echo "============================================================"
echo "  VAULT UNSEAL KEYS -- SAVE THESE SECURELY"
echo "============================================================"
KEY_INDEX=1
for key in $UNSEAL_KEYS; do
    printf "  Key %d: %s\n" "$KEY_INDEX" "$key"
    KEY_INDEX=$((KEY_INDEX + 1))
done
echo ""
echo "  Root Token: $ROOT_TOKEN"
echo "============================================================"
echo "  WARNING: These keys are shown ONCE. Store them safely."
echo "============================================================"
echo ""

# --- Step 4: Unseal Vault ---------------------------------------------------

log "Unsealing Vault (threshold=$UNSEAL_THRESHOLD)..."
KEY_COUNT=0
for key in $UNSEAL_KEYS; do
    vault_curl PUT "sys/unseal" \
        -H "Content-Type: application/json" \
        -d "{\"key\": \"$key\"}" > /dev/null
    KEY_COUNT=$((KEY_COUNT + 1))
    if [ "$KEY_COUNT" -ge "$UNSEAL_THRESHOLD" ]; then
        break
    fi
done
log "Vault unsealed successfully"

# Authenticate with root token for remaining setup
VAULT_TOKEN="$ROOT_TOKEN"

# --- Step 5: Enable Auth Methods ---------------------------------------------

log "Enabling auth methods..."
IFS=',' read -ra METHODS <<< "$AUTH_METHODS"
for method in "${METHODS[@]}"; do
    method=$(echo "$method" | xargs)  # trim whitespace
    [ -z "$method" ] && continue
    log "  Enabling auth method: $method"
    vault_curl POST "sys/auth/$method" \
        -H "Content-Type: application/json" \
        -d "{\"type\": \"$method\"}" || warn "Failed to enable $method (may already exist)"
done

# --- Step 6: Create Admin Policy ---------------------------------------------

log "Creating admin policy..."
ADMIN_POLICY=$(cat <<'POLICY'
# Admin policy -- broad administrative access
# Does NOT include sys/raw or sys/seal for safety

# Manage auth methods
path "sys/auth/*" {
  capabilities = ["create", "read", "update", "delete", "list", "sudo"]
}
path "auth/*" {
  capabilities = ["create", "read", "update", "delete", "list", "sudo"]
}

# Manage policies
path "sys/policies/*" {
  capabilities = ["create", "read", "update", "delete", "list"]
}
path "sys/policy/*" {
  capabilities = ["create", "read", "update", "delete", "list"]
}

# Manage secret engines
path "sys/mounts/*" {
  capabilities = ["create", "read", "update", "delete", "list", "sudo"]
}
path "sys/mounts" {
  capabilities = ["read", "list"]
}

# Read system health and config
path "sys/health" {
  capabilities = ["read", "sudo"]
}
path "sys/config/*" {
  capabilities = ["read", "list"]
}
path "sys/host-info" {
  capabilities = ["read"]
}
path "sys/leader" {
  capabilities = ["read"]
}

# Manage identities
path "identity/*" {
  capabilities = ["create", "read", "update", "delete", "list"]
}

# Access all secret engines
path "+/*" {
  capabilities = ["create", "read", "update", "delete", "list"]
}

# Token management
path "auth/token/*" {
  capabilities = ["create", "read", "update", "delete", "list", "sudo"]
}
POLICY
)

vault_curl PUT "sys/policies/acl/admin" \
    -H "Content-Type: application/json" \
    -d "$(jq -n --arg policy "$ADMIN_POLICY" '{"policy": $policy}')"
log "Admin policy created"

# --- Step 7: Create Admin User -----------------------------------------------

log "Creating admin user: $ADMIN_USER"
vault_curl POST "auth/userpass/users/$ADMIN_USER" \
    -H "Content-Type: application/json" \
    -d "$(jq -n \
        --arg password "$ADMIN_PASS" \
        --arg policies "admin" \
        '{"password": $password, "policies": $policies}')"
log "Admin user created with 'admin' policy"

# --- Step 8: Enable Secret Engines -------------------------------------------

{{- if .ComponentEnabled "vault-secrets" }}
log "Enabling secret engines..."
IFS=',' read -ra ENGINES <<< "$SECRET_ENGINES"
for engine in "${ENGINES[@]}"; do
    engine=$(echo "$engine" | xargs)  # trim whitespace
    [ -z "$engine" ] && continue

    # Determine mount path and engine type
    case "$engine" in
        kv-v2)
            MOUNT_PATH="{{ .Get "vault-secrets/kv-v2-path" }}"
            vault_curl POST "sys/mounts/$MOUNT_PATH" \
                -H "Content-Type: application/json" \
                -d '{"type": "kv", "options": {"version": "2"}}' \
                || warn "Failed to enable $engine at $MOUNT_PATH (may already exist)"
            ;;
        kv-v1)
            MOUNT_PATH="{{ .Get "vault-secrets/kv-v2-path" }}"
            vault_curl POST "sys/mounts/$MOUNT_PATH" \
                -H "Content-Type: application/json" \
                -d '{"type": "kv", "options": {"version": "1"}}' \
                || warn "Failed to enable $engine at $MOUNT_PATH (may already exist)"
            ;;
        transit)
            MOUNT_PATH="{{ .Get "vault-secrets/transit-path" }}"
            vault_curl POST "sys/mounts/$MOUNT_PATH" \
                -H "Content-Type: application/json" \
                -d '{"type": "transit"}' \
                || warn "Failed to enable $engine at $MOUNT_PATH (may already exist)"
            ;;
        pki)
            MOUNT_PATH="{{ .Get "vault-secrets/pki-path" }}"
            vault_curl POST "sys/mounts/$MOUNT_PATH" \
                -H "Content-Type: application/json" \
                -d '{"type": "pki"}' \
                || warn "Failed to enable $engine at $MOUNT_PATH (may already exist)"
            ;;
        totp)
            MOUNT_PATH="{{ .Get "vault-secrets/totp-path" }}"
            vault_curl POST "sys/mounts/$MOUNT_PATH" \
                -H "Content-Type: application/json" \
                -d '{"type": "totp"}' \
                || warn "Failed to enable $engine at $MOUNT_PATH (may already exist)"
            ;;
        *)
            vault_curl POST "sys/mounts/$engine" \
                -H "Content-Type: application/json" \
                -d "{\"type\": \"$engine\"}" \
                || warn "Failed to enable $engine (may already exist)"
            ;;
    esac
    log "  Enabled: $engine"
done
{{- end }}

# --- Step 9: Revoke Root Token -----------------------------------------------

log "Revoking root token..."
vault_curl PUT "auth/token/revoke-self" \
    -H "Content-Type: application/json" \
    -d '{}' || warn "Failed to revoke root token"
unset VAULT_TOKEN ROOT_TOKEN
log "Root token revoked"

# --- Step 10: Cleanup --------------------------------------------------------

# CLEANUP_FILES are handled by the EXIT trap
# Add any generated files that contain secrets
CLEANUP_FILES+=("${SCRIPT_DIR}/apply.sh")

{{- if eq (.Get "vault-deploy/mode") "kubernetes" }}
if [ -n "${PF_PID:-}" ]; then
    kill "$PF_PID" 2>/dev/null || true
fi
{{- end }}

# --- Summary -----------------------------------------------------------------

echo ""
echo "============================================================"
echo "  VAULT DEPLOYMENT COMPLETE"
echo "============================================================"
echo ""
echo "  Vault Address:  $VAULT_ADDR"
echo "  Deploy Mode:    $DEPLOY_MODE"
echo "  Admin User:     $ADMIN_USER (userpass)"
echo ""
echo "  Login with:"
{{- if eq (.Get "vault-server/tls/enabled" | toString) "true" }}
echo '    curl -s -X POST '"$VAULT_ADDR"'/v1/auth/userpass/login/'"$ADMIN_USER"' \'
{{- if .Get "vault-server/tls/server-ca-file" }}
echo '      --cacert '"{{ .Get "vault-server/tls/server-ca-file" }}"' \'
{{- end }}
{{- if .Get "vault-server/tls/client-ca-file" }}
echo '      --cert '"{{ .Get "vault-server/tls/cert-file" }}"' \'
echo '      --key '"{{ .Get "vault-server/tls/key-file" }}"' \'
{{- end }}
echo '      -d '"'"'{"password": "<your-password>"}'"'"
{{- else }}
echo '    curl -s -X POST '"$VAULT_ADDR"'/v1/auth/userpass/login/'"$ADMIN_USER"' \'
echo '      -d '"'"'{"password": "<your-password>"}'"'"
{{- end }}
echo ""
echo "  IMPORTANT: This script has been deleted for security."
echo "============================================================"
